{
  "name": "gate-cs-2027",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive GATE CS 2027 preparation portal",
  "scripts": {
    "dev": "vite",
    "build": "GATE_PARTIAL=1 vite build && tsc --noEmit",
    "build:strict": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "node scripts/site-data.mjs --partial && tsc --noEmit",
    "test": "node scripts/site-data.mjs && node scripts/test-check-manifest.mjs && node scripts/test-check-memory.mjs && node scripts/test-check-claude-memory.mjs && vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "node scripts/check-manifest.mjs --allow-missing && node scripts/check-memory.mjs && node scripts/check-claude-memory.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:memory": "node scripts/check-memory.mjs",
    "memory": "node scripts/check-memory.mjs --write",
    "site-data": "node scripts/site-data.mjs --partial",
    "manifest": "node scripts/build-manifest.mjs --partial",
    "extract": "node scripts/extract-source.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "marked": "^18.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "minisearch": "^7.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  }
}
